# Token from @BotFather (create a NEW bot for trading)
BOT_TOKEN=
# Encrypts every wallet key in the database. deploy.sh generates it on first run.
# BACK IT UP somewhere safe: without it no wallet in the bot can be opened.
MASTER_KEY=
# Max NEAR per single buy, NEAR kept for gas
MAX_BUY_NEAR=100
GAS_RESERVE_NEAR=0.1
# Wallets per user, seconds before messages with keys are deleted
MAX_WALLETS=10
SECRET_MESSAGE_TTL=120
# Optional paid FastNear key (not needed: the bot rotates free public RPCs)
FASTNEAR_API_KEY=
# RPC_URLS=https://rpc.mainnet.fastnear.com,https://free.rpc.fastnear.com,https://rpc.mainnet.near.org
# DB_PATH=trade.db

# Bot fee and referrals: FEE_BPS of every trade goes to FEE_ACCOUNT; REF_SHARES (% of the fee per level) are
# credited to the inviters and paid out from FEE_ACCOUNT (set its key on the server: admin.py payout-key)
FEE_BPS=100
FEE_ACCOUNT=buddhadefi-hot.tg
REF_SHARES=30,10,5
REF_MIN_WITHDRAW_NEAR=0.1
# Your Telegram user id(s) for /admin (get it from @userinfobot)
ADMIN_IDS=
